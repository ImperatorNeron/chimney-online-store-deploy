# -----------------------------------------------------------------------------
# BUILD-TIME frontend variables (NEXT_PUBLIC_*), baked into the browser bundle
# by `next build`. Consumed automatically by build.sh (one --build-arg each).
#
# These are PUBLIC (they end up in client JS) — NO secrets here.
#
# Copy to `.env.build` and fill in real values:
#     cp .env.build.example .env.build
# -----------------------------------------------------------------------------

# SEO / canonical / sitemap links. Set to your PUBLIC domain for prod
# (e.g. https://shop.example.com). Local testing can stay http://localhost:8080.
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# ---- Media ----
# Choose ONE of the two setups below depending on your storage backend.
#
# Railway Buckets / S3 backend (media proxied by our own /media route):
#     media is same-origin, so point everything at /media on the app itself.
NEXT_PUBLIC_MEDIA_URL=/media
NEXT_PUBLIC_MEDIA_HOST=localhost
NEXT_PUBLIC_MEDIA_PATH=/media
NEXT_PUBLIC_MEDIA_SCHEMA=https
NEXT_PUBLIC_MEDIA_PORT=
NEXT_PUBLIC_MEDIA_ITEMS=uploads
NEXT_PUBLIC_MEDIA_CATEGORIES=categories
