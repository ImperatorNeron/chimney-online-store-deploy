# =============================================================================
# SCENARIO 1 — FULLY LOCAL runtime env (backend, read at container start).
# Used by docker-compose.local.yml, which brings up BOTH app + a local Postgres.
# Everything here is LOCAL / non-secret — safe defaults for development.
#
# Copy to `.env.local` and adjust if needed:
#     cp .env.local.example .env.local
#
# NOTE: NEXT_PUBLIC_* are NOT here — those are baked at BUILD time (.env.build).
# =============================================================================

# Dev mode: debug on, Swagger on, cookies non-Secure (plain HTTP), local disk media.
APP_CONFIG__ENVIRONMENT=dev

APP_CONFIG__SESSION__session_secure=false
APP_CONFIG__SESSION__session_httponly=true

# ---- Backend process (internal; nginx proxies to it) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=1
RUN_MIGRATIONS=1

# ---- Database: the 'db' service in docker-compose.local.yml ----
APP_CONFIG__DATABASE__driver=postgresql+asyncpg
APP_CONFIG__DATABASE__user=postgres
APP_CONFIG__DATABASE__password=postgres
APP_CONFIG__DATABASE__host=db
APP_CONFIG__DATABASE__port=5432
# Host port the local DB is published on (so you can psql from your machine).
APP_CONFIG__DATABASE__external_port=5434
APP_CONFIG__DATABASE__db_name=postgres
APP_CONFIG__DATABASE__pool_size=5
APP_CONFIG__DATABASE__max_overflow=5

APP_CONFIG__ALLOW_ORIGINS=http://localhost:8080
