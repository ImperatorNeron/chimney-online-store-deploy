# =============================================================================
# SCENARIO 2 — APP LOCAL with EXTERNAL (prod) DB + bucket.
# Backend runtime env for docker-compose.app-only.yml (app only, no local DB).
#
# Copy to `.env.app-only` and fill REAL prod DB + Supabase creds:
#     cp .env.app-only.example .env.app-only
#
# SECRETS live here (DB password, Supabase service key). This file is gitignored.
# =============================================================================

# We test the app locally over plain HTTP, so keep dev-style cookie/secure flags
# even though the DB/bucket are the real prod ones.
# (Set to 'prod' only if you also serve over HTTPS locally.)
APP_CONFIG__ENVIRONMENT=dev

APP_CONFIG__SESSION__session_secure=false
APP_CONFIG__SESSION__session_httponly=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_CONCURRENCY=1
# Migrations run against the EXTERNAL DB — set 0 if you don't want that.
RUN_MIGRATIONS=0

# ---- EXTERNAL Database (Supabase / Neon / managed Postgres) ----
# Keep the pool SMALL for a remote/pooled DB.
APP_CONFIG__DATABASE__driver=postgresql+asyncpg
APP_CONFIG__DATABASE__user=YOUR_DB_USER
APP_CONFIG__DATABASE__password=YOUR_DB_PASSWORD
APP_CONFIG__DATABASE__host=YOUR_DB_HOST
APP_CONFIG__DATABASE__port=5432
APP_CONFIG__DATABASE__db_name=YOUR_DB_NAME
APP_CONFIG__DATABASE__pool_size=5
APP_CONFIG__DATABASE__max_overflow=5

APP_CONFIG__ALLOW_ORIGINS=http://localhost:8080

# ---- Storage backend selection ----
# supabase | s3 (Railway Buckets) | local (disk).
# This scenario points at the REAL remote storage. For Railway set "s3".
APP_CONFIG__STORAGE_BACKEND=s3

# ---- Railway Bucket (S3-compatible). Buckets are PRIVATE — media is served by
#      the backend /media proxy. Values come from the bucket's Credentials tab.
#      Use BUCKET (the unique S3 name), NOT the display name. ----
APP_CONFIG__S3__endpoint=https://t3.storageapi.dev
APP_CONFIG__S3__access_key_id=YOUR_S3_ACCESS_KEY_ID
APP_CONFIG__S3__secret_access_key=YOUR_S3_SECRET_ACCESS_KEY
APP_CONFIG__S3__bucket=your-bucket-name-xxxxxxxx
APP_CONFIG__S3__region=auto

# ---- Supabase client is still constructed at startup, so these must be
#      NON-EMPTY even in s3 mode. Placeholders are fine (nothing is uploaded to
#      or served from Supabase while STORAGE_BACKEND=s3). ----
APP_CONFIG__BUCKET__supabase_url=https://placeholder.supabase.co
APP_CONFIG__BUCKET__supabase_key=placeholder
APP_CONFIG__BUCKET__name=uploads
